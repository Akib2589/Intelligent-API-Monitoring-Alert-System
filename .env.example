# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/monitoring.db

# Anomaly Thresholds
LATENCY_HIGH_THRESHOLD_MS=3000
LATENCY_WARN_THRESHOLD_MS=1500

# AI Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# Optional Email Notification Service
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="API Monitor Alert" <alerts@apimonitor.local>
ALERT_RECIPIENT_EMAIL=sre-team@example.com

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
